# ExecStartPre of clamav-web (through runagent): write state/ldap.env with the
# connection to the node's ldapproxy for the selected user domain. It runs on
# every start, so a changed bind password of the domain is picked up by a
# restart (see events/user-domain-changed). The file carries the bind
# password: mode 0600, regenerated, not part of the backup.

import os
import sys

import agent
from agent.ldapproxy import Ldapproxy

lines = ["# Generated by bin/discover-ldap. Do not edit by hand."]
domain = os.environ.get("LDAP_DOMAIN", "")
if os.environ.get("WEB_AUTH") == "ldap" and domain:
    odom = None
    try:
        odom = Ldapproxy().get_domain(domain)
    except Exception as exc:
        print(agent.SD_WARNING + f"cannot read the user domain {domain}: {exc}", file=sys.stderr)
    if odom:
        lines += [
            f"LDAP_HOST={odom['host']}",
            f"LDAP_PORT={odom['port']}",
            f"LDAP_SCHEMA={odom['schema']}",
            f"LDAP_BASE_DN={odom['base_dn']}",
            f"LDAP_BIND_DN={odom['bind_dn']}",
            f"LDAP_BIND_PASSWORD={odom['bind_password']}",
        ]
    else:
        # the web front end still starts and refuses every login
        print(agent.SD_WARNING + f"user domain {domain} not found: web logins are refused", file=sys.stderr)

os.umask(0o077)
with open("ldap.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("ldap.env.tmp", "ldap.env")
