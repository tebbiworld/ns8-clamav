# Settings plus live status (daemon reachable, ClamAV/signature version) and
# the addresses clients should use, depending on where they run.

import json
import os
import socket
import subprocess
import sys

import agent
import modsecrets

def clamd_version():
    try:
        with socket.create_connection(("127.0.0.1", 3310), timeout=3) as s:
            s.sendall(b"zVERSION\0")
            return s.recv(256).decode(errors="replace").strip("\0\n")
    except OSError:
        return ""

def node_addresses():
    lan, vpn = [], ""
    try:
        for link in json.loads(subprocess.run(["/usr/sbin/ip", "-j", "-4", "addr"], capture_output=True, text=True, check=True).stdout):
            for a in link.get("addr_info", []):
                # skip loopback and container bridges (podman/cni/veth)
                if link["ifname"] == "lo" or link["ifname"].startswith(("podman", "cni", "veth", "docker", "br-")):
                    continue
                if link["ifname"].startswith("wg"):
                    vpn = vpn or a["local"]
                else:
                    lan.append(a["local"])
    except Exception:
        pass
    return lan, vpn

version = clamd_version()
lan, vpn = node_addresses()
# "ClamAV 1.5.4/27xxx/Sun Sep 13 ..." -> engine, signature db version, db date
parts = version.split("/") if version.startswith("ClamAV") else []
config = {
    "listen_lan": os.getenv("LISTEN_LAN", "false") == "true",
    "max_file_size_mb": int(os.getenv("MAX_FILE_SIZE_MB", "100")),
    "max_scan_size_mb": int(os.getenv("MAX_SCAN_SIZE_MB", "400")),
    "stream_max_length_mb": int(os.getenv("STREAM_MAX_LENGTH_MB", "100")),
    "signature_checks_per_day": int(os.getenv("SIGNATURE_CHECKS_PER_DAY", "12")),
    "daemon_up": bool(version),
    "engine_version": parts[0].replace("ClamAV ", "") if parts else "",
    "signature_version": parts[1] if len(parts) > 1 else "",
    "signature_date": parts[2] if len(parts) > 2 else "",
    "port": 3310,
    "vpn_address": vpn,
    "lan_addresses": lan,
    "web_host": os.getenv("WEB_HOST", ""),
    "lets_encrypt": bool(os.getenv("WEB_HOST")) and agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "web_user": os.getenv("WEB_USER", "scan"),
    "web_password_set": bool(modsecrets.get("WEB_PASSWORD_PBKDF2")),
    "ip_allowlist": [c for c in os.getenv("IP_ALLOWLIST", "").split(",") if c],
    "web_url": f"https://{os.getenv('WEB_HOST')}/" if os.getenv("WEB_HOST") else "",
    "web_port": os.getenv("WEB_PORT", ""),
}
json.dump(config, fp=sys.stdout)
