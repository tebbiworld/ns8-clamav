{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/clamav/get-configuration-output.json",
    "description": "Get ClamAV configuration and status",
    "type": "object",
    "properties": {
        "listen_lan": {
            "type": "boolean"
        },
        "max_file_size_mb": {
            "type": "integer"
        },
        "max_scan_size_mb": {
            "type": "integer"
        },
        "stream_max_length_mb": {
            "type": "integer"
        },
        "signature_checks_per_day": {
            "type": "integer"
        },
        "daemon_up": {
            "type": "boolean"
        },
        "engine_version": {
            "type": "string"
        },
        "signature_version": {
            "type": "string"
        },
        "signature_date": {
            "type": "string"
        },
        "port": {
            "type": "integer"
        },
        "vpn_address": {
            "type": "string"
        },
        "lan_addresses": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "web_host": {
            "type": "string"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "http2https": {
            "type": "boolean"
        },
        "web_auth": {
            "type": "string",
            "enum": ["none", "local", "ldap"]
        },
        "ldap_domain": {
            "type": "string"
        },
        "ldap_group": {
            "type": "string"
        },
        "user_domains": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "web_user": {
            "type": "string"
        },
        "web_password_set": {
            "type": "boolean"
        },
        "ip_allowlist": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "web_url": {
            "type": "string"
        },
        "web_port": {
            "type": "string"
        }
    }
}
