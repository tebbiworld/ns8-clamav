# The web front end's host name must not be used by another Traefik route.

import json
import os
import sys

import agent

agent.set_weight(os.path.basename(__file__), 0)
data = json.load(sys.stdin)
host = (data.get("web_host") or "").strip()
old_host = os.environ.get("WEB_HOST", "")
if host and host != old_host and agent.http_route_in_use(domain=host):
    agent.set_status("validation-failed")
    json.dump([{"field": "web_host", "parameter": "web_host", "value": host, "error": "domain_already_used_in_traefik"}], fp=sys.stdout)
    sys.exit(2)
