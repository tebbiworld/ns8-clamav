# Persist the settings and write state/clamav.env, the --env-file of the
# container. The official image applies every CLAMD_CONF_<Option>=<value> to
# clamd.conf and FRESHCLAM_CONF_<Option> to freshclam.conf at start.

import hashlib
import json
import os
import secrets
import sys

import agent
import modsecrets

data = json.load(sys.stdin)

listen_lan = bool(data.get("listen_lan", False))
max_file = int(data.get("max_file_size_mb") or 100)
max_scan = int(data.get("max_scan_size_mb") or 400)
stream_max = int(data.get("stream_max_length_mb") or 100)
checks = int(data.get("signature_checks_per_day") or 12)

agent.set_env("LISTEN_LAN", "true" if listen_lan else "false")
agent.set_env("MAX_FILE_SIZE_MB", str(max_file))
agent.set_env("MAX_SCAN_SIZE_MB", str(max_scan))
agent.set_env("STREAM_MAX_LENGTH_MB", str(stream_max))
agent.set_env("SIGNATURE_CHECKS_PER_DAY", str(checks))

lines = [
    "# Generated by configure-module. Do not edit by hand.",
    # listen on every address; the node firewall decides who may connect
    "CLAMD_CONF_TCPAddr=0.0.0.0",
    "CLAMD_CONF_TCPSocket=3310",
    f"CLAMD_CONF_MaxFileSize={max_file}M",
    f"CLAMD_CONF_MaxScanSize={max_scan}M",
    f"CLAMD_CONF_StreamMaxLength={stream_max}M",
    # clients such as Nextcloud stream the file (INSTREAM); keep the extended
    # detection defaults of the image otherwise
    f"FRESHCLAM_CHECKS={checks}",
    f"TZ={os.environ.get('TZ', 'UTC')}",
]
new_env = "\n".join(lines) + "\n"
try:
    old_env = open("clamav.env").read()
except FileNotFoundError:
    old_env = None
if new_env != old_env:
    with open("clamav.env.tmp", "w") as fp:
        fp.write(new_env)
    os.replace("clamav.env.tmp", "clamav.env")
    # tell 80start_services that clamd must be restarted (it reloads ~1 GB of
    # signatures, so web-only changes should not interrupt the scan service)
    open(".clamd-restart", "w").close()

# --- Web/REST front end -------------------------------------------------------
# Enabled when a host name is set. Instances created before 1.1.0 have no
# allocated port yet: ask the node for one.
web_host = (data.get("web_host") or "").strip()
web_user = (data.get("web_user") or os.environ.get("WEB_USER") or "scan").strip()
agent.set_env("WEB_HOST", web_host)
agent.set_env("WEB_USER", web_user)
# none / local / ldap; instances before 1.3.0 only knew the local password
web_auth = data.get("web_auth", "local")
ldap_domain = (data.get("ldap_domain") or "").strip() if web_auth == "ldap" else ""
agent.set_env("WEB_AUTH", web_auth)
agent.set_env("LDAP_DOMAIN", ldap_domain)
agent.set_env("LDAP_GROUP", (data.get("ldap_group") or "").strip())
# declare which user domain the module uses (none when the login is local);
# bin/discover-ldap reads its ldapproxy settings when clamav-web starts
bind = [ldap_domain] if web_host and ldap_domain else []
if bind:
    import cluster.userdomains
    if ldap_domain not in cluster.userdomains.list_domains(agent.redis_connect(use_replica=True)):
        print(agent.SD_WARNING + f"user domain {ldap_domain} does not exist in this cluster: web logins are refused", file=sys.stderr)
        bind = []
agent.bind_user_domains(bind, check=True)
agent.set_env("TRAEFIK_HTTP2HTTPS", bool(data.get("http2https", True)))
# kept so restore-module can re-create the route with the same setting
agent.set_env("TRAEFIK_LETS_ENCRYPT", bool(data.get("lets_encrypt", False)))
agent.set_env("IP_ALLOWLIST", ",".join(c.strip() for c in (data.get("ip_allowlist") or []) if c.strip()))
if web_host and not os.environ.get("WEB_PORT"):
    ports = agent.allocate_ports(1, "tcp")  # pre-1.1.0 instance: nothing to keep
    agent.set_env("WEB_PORT", str(ports[0]))
    os.environ["WEB_PORT"] = str(ports[0])

password = data.get("web_password") or ""
if password:
    salt = secrets.token_hex(8)
    iterations = 200000
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), iterations).hex()
    # the password hash is a secret too: state/passwords.env, not the module environment
    modsecrets.write({"WEB_PASSWORD_PBKDF2": f"{salt}${iterations}${digest}"})
web_hash = modsecrets.get("WEB_PASSWORD_PBKDF2") if not password else f"{salt}${iterations}${digest}"

web_lines = [
    "# Generated by configure-module. Do not edit by hand.",
    "HOST=127.0.0.1",
    f"PORT={os.environ.get('WEB_PORT', '8080')}",
    "CLAMD_HOST=127.0.0.1",
    "CLAMD_PORT=3310",
    f"MAX_UPLOAD_BYTES={stream_max * 1024 * 1024}",
    f"WEB_AUTH={web_auth}",
    f"LDAP_GROUP={(data.get('ldap_group') or '').strip()}",
    f"WEB_USER={web_user}",
    f"WEB_PASSWORD_PBKDF2={web_hash}",
    f"WEB_TITLE=ClamAV scanner ({web_host or os.environ.get('MODULE_ID', 'clamav')})",
]
# clamav-web.env carries the password hash: keep it private
os.umask(0o077)
with open("clamav-web.env.tmp", "w") as fp:
    fp.write("\n".join(web_lines) + "\n")
os.replace("clamav-web.env.tmp", "clamav-web.env")
