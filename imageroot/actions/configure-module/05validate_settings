# clamd binds the fixed port 3310 in the host network: refuse to configure a
# second listener on this node (another ClamAV instance, the Mail module's
# clamd uses 11330 and does not clash).

import json
import os
import subprocess
import sys

import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []

def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})

listeners = subprocess.run(["ss", "-tlnHp", "sport = :3310"], capture_output=True, text=True).stdout
if listeners.strip() and "clamd" not in listeners:
    fail("listen_lan", 3310, "port_3310_in_use")

for key in ("max_file_size_mb", "max_scan_size_mb", "stream_max_length_mb"):
    v = data.get(key)
    if v is not None and (int(v) < 1 or int(v) > 4000):
        fail(key, v, "size_out_of_range")
if data.get("max_file_size_mb") and data.get("stream_max_length_mb") and int(data["stream_max_length_mb"]) < int(data["max_file_size_mb"]):
    fail("stream_max_length_mb", data["stream_max_length_mb"], "stream_smaller_than_file")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
