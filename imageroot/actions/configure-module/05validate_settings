# clamd binds the fixed port 3310 in the host network: refuse to configure a
# second listener on this node (another ClamAV instance, the Mail module's
# clamd uses 11330 and does not clash).

import json
import os
import subprocess
import sys

import agent
import modsecrets

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []

def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})

listeners = subprocess.run(["ss", "-tlnHp", "sport = :3310"], capture_output=True, text=True).stdout
if listeners.strip() and "clamd" not in listeners:
    fail("listen_lan", 3310, "port_3310_in_use")

for key in ("max_file_size_mb", "max_scan_size_mb", "stream_max_length_mb"):
    v = data.get(key)
    if v is not None and (int(v) < 1 or int(v) > 4000):
        fail(key, v, "size_out_of_range")
if data.get("max_file_size_mb") and data.get("stream_max_length_mb") and int(data["stream_max_length_mb"]) < int(data["max_file_size_mb"]):
    fail("stream_max_length_mb", data["stream_max_length_mb"], "stream_smaller_than_file")

# Web front end: a local login needs a password on the first enable (later
# saves may keep it), a directory login needs a user domain of the cluster
if (data.get("web_host") or "").strip():
    web_auth = data.get("web_auth", "local")
    local = web_auth == "local"
    if local and not (data.get("web_user") or "").strip():
        fail("web_user", "", "web_user_required")
    if local and not data.get("web_password") and not modsecrets.get("WEB_PASSWORD_PBKDF2"):
        fail("web_password", "", "web_password_required")
    if web_auth == "ldap":
        domain = (data.get("ldap_domain") or "").strip()
        if not domain:
            fail("ldap_domain", "", "ldap_domain_required")
        else:
            import cluster.userdomains
            rdb = agent.redis_connect(use_replica=True)
            # a restore on a cluster without that domain keeps the stored
            # value: the front end then refuses every login until it is fixed
            if domain not in cluster.userdomains.list_domains(rdb) and domain != os.environ.get("LDAP_DOMAIN"):
                fail("ldap_domain", domain, "ldap_domain_unknown")
    if local and data.get("web_password") and len(data["web_password"]) < 8:
        fail("web_password", "", "web_password_too_short")
    import ipaddress
    for cidr in data.get("ip_allowlist") or []:
        try:
            ipaddress.ip_network(cidr.strip(), strict=False)
        except ValueError:
            fail("ip_allowlist", cidr, "invalid_cidr")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
