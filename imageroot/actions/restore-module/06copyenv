# Copy the non-secret settings of the original instance. The password hash
# comes back with the restored state/passwords.env; a backup taken with an
# older module version still carries it in the environment. WEB_PORT is not
# copied: the new instance gets its own port.

import json
import sys

import agent
import modsecrets

request = json.load(sys.stdin)
if "environment" in request:
    # restore-module: the environment of the backup comes with the request
    env = request["environment"]
else:
    # clone-module (this file is linked there as 20copyenv): the core imports only
    # the variables the new instance does not have yet, so everything preset by
    # create-module would keep its default. The core leaves the source instance's
    # environment in state/environment.clone-module until its last step.
    env = agent.read_envfile("environment.clone-module")

KEEP = ["LISTEN_LAN", "MAX_FILE_SIZE_MB", "MAX_SCAN_SIZE_MB", "STREAM_MAX_LENGTH_MB", "SIGNATURE_CHECKS_PER_DAY",
        "WEB_HOST", "WEB_AUTH", "LDAP_DOMAIN", "LDAP_GROUP", "WEB_USER", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "IP_ALLOWLIST"]

agent.mset_env({k: env[k] for k in KEEP if k in env})

if env.get("WEB_PASSWORD_PBKDF2"):
    modsecrets.write({"WEB_PASSWORD_PBKDF2": env["WEB_PASSWORD_PBKDF2"]})
    print("restored the legacy password hash from the backup environment into passwords.env", file=sys.stderr)
modsecrets.ensure({})
