# Up to 1.1.0 the password hash of the web front end was stored with
# agent.set_env(), i.e. in state/environment, which the agent mirrors to Redis
# in plain text. Move it to state/passwords.env (0600); the value does not
# change.

import os

import modsecrets

modsecrets.migrate_from_env(["WEB_PASSWORD_PBKDF2"])

# clamav-web.env carries the hash as well
path = os.path.join(os.environ["AGENT_STATE_DIR"], "clamav-web.env")
if os.path.exists(path):
    os.chmod(path, 0o600)
