# The core's update-module action does not restart the module's units; restart
# so a new pinned ClamAV version runs right after the update.

set -e
exec 1>&2

systemctl --user daemon-reload
systemctl --user try-restart clamav.service
systemctl --user try-restart clamav-web.service
