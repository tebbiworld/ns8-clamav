# The domain's LDAP settings changed (e.g. a new bind password or provider):
# restart the web front end, bin/discover-ldap reads them again at start.

import json
import os
import sys

import agent

event = json.load(sys.stdin)
if os.environ.get("WEB_AUTH") != "ldap" or event.get("domain") != os.environ.get("LDAP_DOMAIN"):
    sys.exit(0)
agent.run_helper("systemctl", "--user", "-T", "try-restart", "clamav-web.service")
